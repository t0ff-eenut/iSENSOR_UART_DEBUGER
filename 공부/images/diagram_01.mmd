flowchart TD
    subgraph INPUT["📥 입력층"]
        A["24개 특징 벡터\npeak_freq · peak_mag · std_mag\ncentroid · low_energy · mid_energy\nrms · low_ratio · spectral_entropy\npeak_to_mean · 저주파 빈 1~15"]
    end

    subgraph H1["🧠 은닉층 1"]
        B1["Linear  24 → 64"]
        B2["BatchNorm1d  (정규화)"]
        B3["ReLU  max(0, x)"]
        B4["Dropout  30%  (과적합 방지)"]
        B1 --> B2 --> B3 --> B4
    end

    subgraph H2["🧠 은닉층 2"]
        C1["Linear  64 → 32"]
        C2["ReLU"]
        C1 --> C2
    end

    subgraph OUT["📤 출력층"]
        D["Linear  32 → 2\n(logit 점수)"]
        E["Softmax\n합계 = 1.0 인 확률로 변환"]
        F0["🟢 BACKGROUND 확률"]
        F1["🔴 HUMAN 확률"]
        D --> E
        E --> F0
        E --> F1
    end

    INPUT --> H1
    H1 --> H2
    H2 --> OUT

