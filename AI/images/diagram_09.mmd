flowchart TD
    subgraph INPUT["📥 입력"]
        A["원시 스펙트럼  151개 빈\nmagnitudes_0 ~ magnitudes_150\n(DC 0Hz ~ 50Hz)\nshape: 151"]
    end

    subgraph RESHAPE["🔀 reshape"]
        B["(batch, 151)  →  (batch, 1채널, 151)"]
    end

    subgraph C1["🔎 Conv층 1  — 저수준 패턴"]
        CA["Conv1d  1채널 → 16채널  kernel=5\n5개 연속 빈에서 에너지 패턴 감지"]
        CB["BatchNorm1d  +  ReLU"]
        CC["MaxPool1d(2)  ▶  151 → 75\n인접한 2개 중 큰 값만 통과"]
        CA --> CB --> CC
    end

    subgraph C2["🔍 Conv층 2  — 중간 패턴"]
        DA["Conv1d  16채널 → 32채널  kernel=3\n패턴들의 조합 학습"]
        DB["BatchNorm1d  +  ReLU"]
        DC["MaxPool1d(2)  ▶  75 → 37"]
        DA --> DB --> DC
    end

    subgraph C3["🔬 Conv층 3  — 고수준 패턴"]
        EA["Conv1d  32채널 → 64채널  kernel=3\n사람/배경 특유 구조 추출"]
        EB["BatchNorm1d  +  ReLU"]
        EC["AdaptiveAvgPool1d(4)  ▶  37 → 4\n고정 크기로 압축"]
        EA --> EB --> EC
    end

    subgraph FLAT["📐 Flatten"]
        F["(batch, 64채널, 4)  →  (batch, 256)\n1D 벡터로 펼치기"]
    end

    subgraph FC["🧠 완전연결층"]
        GA["Linear  256 → 64  +  ReLU"]
        GB["Dropout  30%"]
        GC["Linear  64 → 2  (logit 점수)"]
        GD["Softmax  →  확률"]
        GA --> GB --> GC --> GD
    end

    subgraph OUT["📤 출력"]
        H0["🟢 BACKGROUND 확률"]
        H1["🔴 HUMAN 확률"]
    end

    INPUT --> RESHAPE --> C1 --> C2 --> C3 --> FLAT --> FC --> OUT

    style INPUT   fill:#1a1a2e,color:#eee,stroke:#f4a261
    style RESHAPE fill:#1a1a2e,color:#eee,stroke:#aaa
    style C1      fill:#1a1a2e,color:#eee,stroke:#f4a261
    style C2      fill:#1a1a2e,color:#eee,stroke:#f4a261
    style C3      fill:#1a1a2e,color:#eee,stroke:#f4a261
    style FLAT    fill:#1a1a2e,color:#eee,stroke:#aaa
    style FC      fill:#16213e,color:#eee,stroke:#f4a261
    style OUT     fill:#0f3460,color:#eee,stroke:#f4a261
    style H0      fill:#2d6a4f,color:#fff,stroke:#52b788
    style H1      fill:#7b2d2d,color:#fff,stroke:#e63946